<h1>Editar Livro</h1>

<form action="/livros/editar/{{livro.id}}" method="POST">

    <p>
        <label>Título:</label>
        <input
            type="text"
            name="titulo"
            value="{{livro.titulo}}"
            required>
    </p>

    <p>
        <label>Autor:</label>
        <input
            type="text"
            name="autor"
            value="{{livro.autor}}"
            required>
    </p>

    <p>
        <label>Ano:</label>
        <input
            type="number"
            name="ano"
            value="{{livro.ano}}"
            required>
    </p>

    <button type="submit">
        Salvar
    </button>

</form>

<br>

<a href="/livros">
    Voltar
</a>
