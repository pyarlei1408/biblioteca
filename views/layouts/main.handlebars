<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <title>Biblioteca</title>

    <style>
        body {
            font-family: Arial;
            max-width: 900px;
            margin: 40px auto;
            padding: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #ccc;
            padding: 10px;
        }

        a, button {
            padding: 8px 12px;
            text-decoration: none;
            cursor: pointer;
        }

        .cadastrar {
            background: green;
            color: white;
        }

        .editar {
            background: blue;
            color: white;
        }

        .excluir {
            background: red;
            color: white;
            border: none;
        }
    </style>
</head>

<body>

    {{{body}}}

</body>

</html>

