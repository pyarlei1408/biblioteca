<h1>Cadastrar Livro</h1>

<form action="/livros" method="POST">

    <p>
        <label>Título:</label>
        <input type="text" name="titulo" required>
    </p>

    <p>
        <label>Autor:</label>
        <input type="text" name="autor" required>
    </p>

    <p>
        <label>Ano:</label>
        <input type="number" name="ano" required>
    </p>

    <button type="submit">
        Cadastrar
    </button>

</form>

<br>

<a href="/livros">
    Voltar
</a>
